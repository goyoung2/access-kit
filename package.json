{
  "name": "access-kit",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-protocol https --port 8792",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts packages/sdk/test/*.test.mjs",
    "benchmark:admin": "node --import tsx scripts/benchmark-admin-cpu.mjs",
    "sdk:pack": "node scripts/pack-sdk.mjs",
    "db:migrate:local": "wrangler d1 migrations apply access-kit --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "tar": "7.5.22",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "wrangler": "4.160.1"
  },
  "workspaces": [
    "packages/sdk"
  ]
}
