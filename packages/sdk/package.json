{
  "name": "access-kit-sdk",
  "version": "0.3.1",
  "description": "Google sign-in, approved-member access gates and installation CLI for Access Kit",
  "type": "module",
  "license": "MIT",
  "bin": {
    "access-kit": "./bin/access-kit.mjs"
  },
  "exports": {
